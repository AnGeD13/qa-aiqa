{
  "name": "qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "report": "playwright show-report",
    "lint": "eslint --no-error-on-unmatched-pattern \"automation/**/*.ts\"",
    "lint:fix": "eslint --no-error-on-unmatched-pattern \"automation/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --no-error-on-unmatched-pattern \"*.{json,mjs,ts}\" \"automation/**/*.ts\" --write",
    "format:check": "prettier --no-error-on-unmatched-pattern \"*.{json,mjs,ts}\" \"automation/**/*.ts\" --check",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
